# ========================================================
# CMMS Configuration Template (.env.example)
# Salin file ini menjadi .env untuk konfigurasi lokal Anda
# ========================================================

# 1. Konfigurasi Database
# Opsi A: SQLite (Default untuk development & mockup redesign - tidak perlu install server DB)
DATABASE_URL=sqlite:///cmms.db

# Opsi B: MySQL (Jika menggunakan MySQL lokal/server)
# DATABASE_URL=mysql+mysqlconnector://root:password@127.0.0.1:3306/cmms_db

# 2. Flask Secret Key (Ganti dengan string random aman untuk production)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# 3. Integrasi WhatsApp Fonnte (Opsional untuk pengiriman pesan WO & Helpdesk)
FONNTE_TOKEN=your-fonnte-token-here
FONNTE_API_URL=https://api.fonnte.com/send

# 4. Integrasi AI Assistant / Chatbot (Opsional)
GROQ_API_KEY=your-groq-api-key-here
SUMOPOD_BASE_URL=https://ai.sumopod.com
SUMOPOD_API_KEY=your-sumopod-api-key-here
SUMOPOD_MODEL=gpt-5-nano

# 5. External Chiller / IoT Monitoring API (Opsional)
CHILLER_API_BASE_URL=http://127.0.0.1:8000
IOT_MYSQL_HOST=127.0.0.1
IOT_MYSQL_PORT=3306
IOT_MYSQL_USER=root
IOT_MYSQL_PASSWORD=
IOT_MYSQL_DB=iot_db
